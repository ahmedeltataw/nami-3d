  "clip_notes": {
    "Idle": "Torso float z=0.04*sin(2*pi*t/4) (glTF y), sway rotZ 0.6 deg; 4 s seamless loop",
    "Sleep": "static: Head +8 deg Blender X (face down), Torso +3 deg X, -0.02 z; eyes closed by scale y=0.08 on Eye_L/Eye_R and Eye_CircuitDetails (glTF y)",
    "WakeUp": "Sleep pose -> rest over 1.2 s; eyes open frames 8-30",
    "Wave": "M1-04a clip, handles clamped",
    "eye_emission": "not animated in the GLB (three.js has no KHR_animation_pointer); drive emissiveIntensity of MAT_EyeEmission in code if needed",
    "LookAround": "head+neck yaw left/right then up; eyes lead the head",
    "Draw": "right arm level, sweeps side -> front (Shoulder_R X -28 -> -86 at Y 90); palm leads; head tracks",
    "ChargeEnergy": "rest -> charge pose by 0.8 s, held to 2.0 s with a palm tremble; ENDS in the charge pose (palm centres ~1.5 apart: inward shoulder/elbow limits)",
    "OpenPortal": "STARTS in the ChargeEnergy end pose -> arms sweep out/up (0.8 s), hold, back to rest at 2.0 s",
    "Fly": "loop; Torso pitched +15 deg (its limit; brief asked ~25: add the rest on a parent group in-app), arms back, bob 0.05",
    "Present": "right arm forward and out, palm up (forward toward the camera, slightly to the robot's right); head looks at it and nods",
    "Point": "right arm level, 40 deg out from straight ahead (robot right = screen left); Finger_1 straight, others curled; head + torso turn to it",
    "Thinking": "loop; right hand up by the chin, head tilt 8 deg, torso sway 3 deg",
    "Grab": "both arms reach forward, fingers close at 0.6-0.73 s, return to rest",
    "React": "head tilt 8 deg + 0.03 hop",
    "Celebrate": "both arms up, 3 bounces of 0.05",
    "Guide": "right arm level sweeps front -> robot right (screen left), open palm forward; head follows then returns",
    "rest": "non-looping clips start and end at rest, except ChargeEnergy (ends in its held pose) and OpenPortal (starts from that pose)"
  },
